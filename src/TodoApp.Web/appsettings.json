{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=todoapp;Username=todoapp;Password=__SET_IN_ENV__"
  },
  "JwtSettings": {
    "Key": "DevelopmentOnlyJwtKey-ChangeMe-12345",
    "Issuer": "TodoApp",
    "Audience": "TodoAppUsers",
    "ExpirationInMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "OpenTelemetry": {
    "ServiceName": "TodoApp.Web",
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "AllowedHosts": "*"
}
